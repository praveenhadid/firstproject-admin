# ---- Login (there is no database; these are the only credentials) ----
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Optional. Session lifetime in seconds (default: 43200 = 12 hours).
# SESSION_MAX_AGE=43200

# ---- Video library: a base URL plus a run of numbered files ----
# Produces <VIDEO_BASE_URL>/<n><VIDEO_EXTENSION> for every n in the range.
VIDEO_BASE_URL=https://example.com/files/
VIDEO_ID_START=1
VIDEO_ID_END=100
# Optional (default: .mp4)
# VIDEO_EXTENSION=.mp4
# Optional. Videos per page (default: 24, max: 120).
# VIDEO_PAGE_SIZE=24

# ---- Alternative: an explicit list, which overrides the range above ----
# VIDEOS_JSON=[{"id":"intro","title":"Intro","url":"https://example.com/intro.mp4","poster":"https://example.com/intro.jpg"}]

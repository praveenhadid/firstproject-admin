# ---- Login (there is no database; these are the only credentials) ----
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Optional. Session lifetime in seconds (default: 43200 = 12 hours).
# SESSION_MAX_AGE=43200

# ---- Links ----
# Each base URL is one folder on the dashboard, holding folders of videos.
# The first is unsuffixed; number the rest _1, _2, _3.
# Every video is <base>/<id><extension>.
VIDEO_BASE_URL=https://host2.example.com/files/id/
# VIDEO_BASE_URL_1=https://host3.example.com/files/id/
VIDEO_EXTENSION=.mp4

# Optional per-link overrides.
# VIDEO_EXTENSION_1=.mkv
# VIDEO_LABEL_1=Archive        # display name; defaults to the host and path
# VIDEO_SOURCE_ID_1=archive    # url slug; defaults to e.g. host3-files-id

# ---- Background scanner (builds the folders) ----
# Sweeps each link's id space while the site is live, recording which files
# really exist into data/videos-manifest.json. Links are done in order: when
# one finishes, the next starts.
VIDEO_SCAN_ENABLED=true
VIDEO_SCAN_FROM=1
VIDEO_SCAN_TO=100000
# Per-link windows. Worth narrowing when you know roughly where the files are.
# VIDEO_SCAN_FROM_1=60000
# VIDEO_SCAN_TO_1=75000
# Probes in flight. Kept low so the scan doesn't crowd out video playback.
VIDEO_SCAN_CONCURRENCY=6

# ---- Sizing ----
# Working videos per folder inside a link (default: 1000).
VIDEO_FOLDER_SIZE=1000
# Videos per page inside a folder (default: 10, max: 120).
VIDEO_PAGE_SIZE=10
